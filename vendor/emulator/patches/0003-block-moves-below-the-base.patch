+    /// A block move with a register base (`block_move_raw`): the registers in `mask`, lowest
+    /// first, to or from consecutive words starting at the base, or ending just below it when
+    /// `down`. Every address comes from the base as it was; `post` then moves the base past the
+    /// block, up or down.
+    fn block_move<B: Bus>(&mut self, bus: &mut B, base: usize, mask: u16, store: bool, down: bool, post: bool) {
+        let size = 4 * mask.count_ones();
+        let start = if down { self.regs[base].wrapping_sub(size) } else { self.regs[base] };
+        let mut addr = start;
+        for i in 0..16usize {
+            if mask >> i & 1 != 0 {
+                if store {
+                    bus.write32(addr, self.regs[i]);
+                } else {
+                    self.regs[i] = bus.read32(addr);
+                }
+                addr = addr.wrapping_add(4);
+            }
+        }
+        if post {
+            self.regs[base] = if down { start } else { addr };
+        }
+    }

#!/bin/sh
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 japes98
#
# Git commit-msg hook: the message must follow .gitmessage (R-PROC-1).
# Turned on by tools/install-hooks.sh (core.hooksPath = tools/hooks).
top=$(git rev-parse --show-toplevel)
py=$(sh "$top/tools/find-python.sh") || exit 1
exec "$py" -I "$top/tools/check-commit-msg.py" --file "$1"

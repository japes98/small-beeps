#!/bin/sh
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 japes98
#
# Git pre-commit hook: no staged file may hold one of the owner's private
# terms (R-PUB-3). Turned on by tools/install-hooks.sh.
top=$(git rev-parse --show-toplevel)
py=$(sh "$top/tools/find-python.sh") || exit 1
exec "$py" -I "$top/tools/check-private.py" --staged

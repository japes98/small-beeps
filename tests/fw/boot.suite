tone        completed  ../../out/fw/app.bin           --ms 2600 --script scripts/tone.txt --wav --ipb --console --ram 0x01c00550:0x40@end --ram 0x01c00000:0x60@end
notes       completed  ../../out/fw/app.bin           --ms 3900 --script scripts/notes.txt --wav --ipb --console --ram 0x01c00060:0x4f0@end --ram 0x01c00550:0x40@end --ram 0x01c00000:0x60@end
audioload   completed  ../../out/fw/app.bin           --ms 11000 --script scripts/audioload.txt --ipb --console --ram 0x01c00060:0x4f0@end --ram 0x01c00550:0x40@end --ram 0x01c00000:0x60@end
audiogold   completed  ../../out/fw/app.bin           --ms 500 --script scripts/audiogold.txt --wav --ipb --console --ram 0x01c00550:0x40@end --golden golden/audiogold

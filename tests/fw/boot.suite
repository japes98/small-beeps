encoders    completed  ../../out/fw/app.bin           --ms 2300 --script scripts/encoders.txt --ram 0x01c00060:0x4f0@1000 --ram 0x01c00060:0x4f0@end --ram 0x01c00000:0x60@end
pot         completed  ../../out/fw/app.bin           --ms 1300 --script scripts/pot.txt --ram 0x01c00060:0x4f0@960 --ram 0x01c00060:0x4f0@end --ram 0x01c00000:0x60@end
leds        completed  ../../out/fw/test-leds.bin     --ms 1000 --leds-every 96 --ram 0x01c00000:0x60@end

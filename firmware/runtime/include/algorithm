 *
 * <algorithm>: only the templates Plaits uses (min, max, swap, fill, copy,
 * sort), so C++ builds without a C++ library. Ours, from the C++
 * standard's descriptions (docs/DESIGN-NOTES.md, M4b); since clean-1027
 * the platform's runtime (firmware/runtime/, BR-4).
 */

#ifndef SB_RUNTIME_ALGORITHM
#define SB_RUNTIME_ALGORITHM

namespace std {

template<class T> inline const T& min(const T& a, const T& b) { return b < a ? b : a; }
template<class T> inline const T& max(const T& a, const T& b) { return a < b ? b : a; }
template<class T> inline void swap(T& a, T& b) { T t = a; a = b; b = t; }

template<class I, class T> inline void fill(I first, I last, const T& value)
{
    for (; first != last; ++first)
        *first = value;
}

template<class I, class O> inline O copy(I first, I last, O out)
{
    for (; first != last; ++first, ++out)
        *out = *first;
    return out;
}

/* Insertion sort: Plaits sorts only a handful of chord ratios, once. */
template<class I> inline void sort(I first, I last)
{
    for (I i = first; i != last; ++i)
        for (I j = i; j != first && *j < *(j - 1); --j)
            swap(*j, *(j - 1));
}

}  /* namespace std */

#endif

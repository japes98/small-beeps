{
  "permissions": {
    "deny": [
      "Read(./vendor/emulator/**)",
      "Read(./harness/**)",
      "Read(**/fm1-sid/**)",
      "WebFetch(domain:hugelton.github.io)",
      "WebFetch(domain:thefirmwarehub.com)",
      "Bash(git clone*Felucca*)",
      "Bash(git clone*felucca*)",
      "Bash(git clone*dinghy*)",
      "Bash(git clone*fm1-emu*)",
      "Bash(git clone*f-emulator*)",
      "Read(./sessions/spec/**)",
      "Bash(git clone*small-beeps-ports*)"
    ]
  },
  "env": {
    "GIT_NO_LAZY_FETCH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/session-banner.sh"
          }
        ]
      }
    ]
  }
}

#
# The spec-side experiments (README.md) as one fwtest suite: each case's
# golden files are the results docs/HARDWARE-SPEC.md cites (E-n), so CI
# (C-SPEC-EXPERIMENTS) notices when the harness stops agreeing with them.
# NAME  EXPECT  IMAGE  [run options; paths relative to this file]
e1-boot    halt      images/e1-boot.bin --ms 1 --ram 0x01c00100:0x80@end --ram 0x01c00200:0x40@end --golden golden/e1-boot
e2-console halt      images/e2-console.bin --ms 1 --console --golden golden/e2-console
e3-timers  completed images/e3-timers.bin --ms 50 --ram 0x01c00100:0x20@end --golden golden/e3-timers
e4-core1   completed images/e4-core1.bin --ms 2 --ram 0x01c00100:0x30@end --golden golden/e4-core1
e5-lcd     halt      images/e5-lcd.bin --ms 10 --lcd 1 --lcd end --golden golden/e5-lcd
e6-matrix  completed images/e6-matrix.bin --ms 260 --script scripts/e6-matrix.txt --ram 0x01c00100:0x40@end --ram 0x01c01000:0x400@end --golden golden/e6-matrix
e7-leds    completed images/e7-leds.bin --ms 120 --leds-every 0.5 --golden golden/e7-leds
e8-adc     completed images/e8-adc.bin --ms 8 --script scripts/e8-adc.txt --ram 0x01c00100:0x40@1 --ram 0x01c00100:0x40@3 --ram 0x01c00100:0x40@5 --ram 0x01c00100:0x40@end --golden golden/e8-adc
e9-audio   completed images/e9-audio.bin --ms 20 --wav --ipb --ram 0x01c00100:0x24@end --golden golden/e9-audio
e10-faults halt      images/e10-faults.bin --ms 2 --console --ram 0x01c00100:0x94@end --golden golden/e10-faults
e11-undefined fault  images/e11-undefined.bin --ms 2 --ram 0x01c00100:0x10@end --golden golden/e11-undefined
e12-badjump fault    images/e12-badjump.bin --ms 2 --ram 0x01c00100:0x10@end --golden golden/e12-badjump
e13-timer-ack completed images/e13-timer-ack.bin --ms 260 --ram 0x01c00100:0x28@end --golden golden/e13-timer-ack
e14-undefined-inline fault images/e14-undefined-inline.bin --ms 2 --ram 0x01c00100:0x10@end --golden golden/e14-undefined-inline
e15-spi1-irq halt    images/e15-spi1-irq.bin --ms 2 --ram 0x01c00100:0x4c@end --golden golden/e15-spi1-irq
e16-lcd-frame halt   images/e16-lcd-frame.bin --ms 10 --lcd end --golden golden/e16-lcd-frame
e17-adc-irq halt     images/e17-adc-irq.bin --ms 2 --ram 0x01c00100:0x44@end --golden golden/e17-adc-irq
e18-block-moves halt images/e18-block-moves.bin --ms 2 --ram 0x01c00100:0x54@end --ram 0x01c01200:0x100@end --golden golden/e18-block-moves
e19-midi-rx completed images/e19-midi-rx.bin --ms 20 --script scripts/e19-midi-rx.txt --ram 0x01c00100:0x38@end --ram 0x01c00200:0x10@end --ram 0x01c01000:0x80@end --golden golden/e19-midi-rx
e20-midi-rx-cases completed images/e20-midi-rx-cases.bin --ms 12 --script scripts/e20-midi-rx-cases.txt --ram 0x01c00100:0x30@end --ram 0x01c00200:0x10@end --ram 0x01c00300:0x10@end --golden golden/e20-midi-rx-cases
e21-midi-tx completed images/e21-midi-tx.bin --ms 8 --midi-out --ram 0x01c00100:0x24@end --golden golden/e21-midi-tx
e22-flash  halt      images/e22-flash.bin --ms 60 --ram 0x01c00100:0x4c@end --golden golden/e22-flash
